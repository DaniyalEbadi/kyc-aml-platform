# Application
APP_NAME=پارس‌هویت
APP_ENV=development
DEMO_MODE=true
SECRET_KEY=change-me-in-production-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# URLs
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Database (SQLite for local demo; PostgreSQL in Docker)
DATABASE_URL=sqlite:///./storage/kyc.db
# DATABASE_URL=postgresql+psycopg://kyc:kyc@localhost:5432/kyc

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
INLINE_JOBS=true

# Storage
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage/files
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# AI providers (leave empty for mock adapters)
LLM_PROVIDER=mock
OCR_PROVIDER=mock
VISION_PROVIDER=mock
EMBEDDING_PROVIDER=mock
SCREENING_PROVIDER=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# Security
MAX_UPLOAD_MB=12
ALLOWED_UPLOAD_TYPES=image/jpeg,image/png,application/pdf
RATE_LIMIT_PER_MINUTE=120
